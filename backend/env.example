# ─────────────────────────────────────────────────────────────
# Mirra — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!
# ─────────────────────────────────────────────────────────────

# Django
SECRET_KEY=django-insecure-mirra-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Set USE_SQLITE=True for local dev (no Supabase needed)
# Set USE_SQLITE=False to connect to Supabase PostgreSQL
USE_SQLITE=True
DB_NAME=mirra
DB_USER=postgres
DB_PASSWORD=
DB_HOST=db.xxxxx.supabase.co
DB_PORT=5432

# Supabase (required when USE_SQLITE=False OR for Realtime features)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare R2 Storage
# Set USE_R2=False for local dev (files saved to media/ folder)
USE_R2=False
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=mirra-media
CLOUDFLARE_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_REGION=eeur

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@mirra.com.tr

# Mirra App
MIRRA_APP_URL=http://localhost:3000
MAX_ALBUM_SIZE=100